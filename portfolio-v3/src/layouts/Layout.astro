---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { siteConfig } from "../config";
import "../styles/global.css";

// Central switch: src/config.ts -> pageTransitions.enabled
const { pageTransitions } = siteConfig;

interface Props {
	title?: string;
	description?: string;
	/** "standard" = readable page width (default). "wide" = documentation canvas. */
	width?: "standard" | "wide";
}

const {
	title = "Portfolio",
	description = "Technical Artist & Game Developer",
	width = "standard",
} = Astro.props;

// Full literal class strings so Tailwind can detect them.
const mainWidth = {
	standard: "max-w-5xl px-6",
	wide: "max-w-[1600px] px-0",
}[width];
---

<!doctype html>
<html lang="en" style={pageTransitions.enabled ? `--vt-duration: ${pageTransitions.durationMs}ms` : undefined}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<!-- The fonts used above the fold, fetched in parallel with the CSS instead of after it. -->
		<link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/oswald-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />

		<meta name="color-scheme" content="light dark" />
		{pageTransitions.enabled && <ClientRouter />}
		<script is:inline>
			(function () {
				var theme;
				try { theme = localStorage.getItem("theme"); } catch (e) {}
				if (theme !== "light" && theme !== "dark") {
					theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
				}
				document.documentElement.dataset.theme = theme;
				// With page transitions the incoming document starts without a theme: carry the current one over.
				document.addEventListener("astro:before-swap", function (event) {
					event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
				});
			})();
		</script>

		<noscript><style>[data-theme-toggle] { display: none; }</style></noscript>

		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- <link rel="stylesheet" href="/styles/global.css"> Imported via Astro -->
		<!-- <meta name="generator" content={Astro.generator} /> -->
	</head>

	<!-- Site shell: a full-height column. <main> grows (flex-1), so the footer is pushed to the
	     bottom edge on short pages and simply follows the content on long ones. -->
	<body class="flex min-h-dvh flex-col bg-background text-text font-sans antialiased" style="scroll-behavior: smooth">
	<a
		href="#main"
		class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-md focus:border focus:border-border-strong focus:bg-surface focus:px-4 focus:py-2 focus:text-sm focus:text-text"
	>
		Skip to main content
	</a>
		<Navbar />

		<!-- w-full: in a flex column, mx-auto would otherwise shrink <main> to its content width. -->
		<main id="main" tabindex="-1" class={`mx-auto w-full flex-1 ${mainWidth} py-10 focus:outline-none`}>
			<slot />
		</main>

		<Footer />
	</body>
</html>

<style>
	/* No fixed height on html/body: the body's min-height (min-h-dvh) drives the shell, so tall
	   pages grow the document instead of overflowing a 100%-high box. */
	html,
	body {
		margin: 0;
		width: 100%;
		scroll-behavior: smooth;
	}

	/* html only: with overflow-x on body too, body becomes its own scroll container
       and window scroll events (BackToTop) stop firing. */
	html {
		overflow-x: hidden;
	}
</style>
