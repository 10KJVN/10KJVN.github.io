---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

const {
	title = "Portfolio",
	description = "Technical Artist & Game Developer",
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
		<!-- <meta name="generator" content={Astro.generator} /> -->
	</head>

	<body class="bg-[#0d1117] text-white font-sans antialiased">
		<div class="mx-aut max-w-5x1 px-6">
			<Navbar />
		</div>

		<main class="mx-auto max-w-5x1 px-6 py-10">
			<slot />
		</main>

		<footer class="mx-auto max-w-5xl px-6">
			<Footer />
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
