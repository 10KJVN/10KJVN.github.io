---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
	/** "standard" = readable page width (default). "wide" = documentation canvas. */
	width?: "standard" | "wide";
}

const {
	title = "Portfolio",
	description = "Technical Artist & Game Developer",
	width = "standard",
} = Astro.props;

// Full literal class strings so Tailwind can detect them.
const mainWidth = {
	standard: "max-w-5xl px-6",
	wide: "max-w-[1600px] px-0",
}[width];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<!-- <link rel="stylesheet" href="/styles/global.css"> Imported via Astro -->
		<!-- <meta name="generator" content={Astro.generator} /> -->
	</head>

	<body class="bg-background text-text font-sans antialiased" style="scroll-behavior: smooth">
		<div class="mx-auto max-w-5xl px-6">
			<Navbar />
		</div>

		<main class={`mx-auto ${mainWidth} py-10`}>
			<slot />
		</main>

		<footer class="mx-auto max-w-5xl px-6">
			<Footer />
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* html only: with overflow-x on body too, body becomes its own scroll container
       and window scroll events (BackToTop) stop firing. */
	html {
		overflow-x: hidden;
	}
</style>
