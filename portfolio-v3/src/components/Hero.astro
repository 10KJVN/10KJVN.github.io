---

<section class="relative left-1/2 -translate-x-1/2 w-screen min-h-screen overflow-hidden">
  <div class="grid md:grid-cols-2 min-h-screen">

    <!-- Void zone (merged About teaser) -->
    <div class="relative flex flex-col justify-center px-10 py-16 bg-white text-[#0d1117]">

      <!-- hero-eyebrow -->
      <span class="relative z-10 text-sm uppercase tracking-widest px-3 py-1 rounded-full border border-black/10 bg-black/5 text-black w-fit">
        Game Developer ❖ Technical Artist
      </span>

      <!-- hero-name -->
      <h1 class="glitch mt-6 text-6xl font-bold leading-none" data-text="JAHVAIRO MONKAU">
        JAHVAIRO <br /> MONKAU
      </h1>

      <!-- hero-subtitle-block -->
      <p class="mt-4 text-lg text-black/70">
        3 word catch phrase
      </p>

      <!-- hero-description -->
      <p class="mt-4 max-w-md text-black/50 leading-relaxed">
        Gameplay-first, built with a growing focus on shaders, rendering, and the
        visual craft that makes a game feel alive.
      </p>

      <!-- hero-cta's -->
      <div class="mt-8 flex gap-4">
        <a href="/#featured" class="px-5 py-2 rounded-md bg-sky-500 hover:bg-sky-400 transition text-sm font-medium text-white">
          View My Work
        </a>
        <a href="/about" class="px-5 py-2 rounded-md border border-black/20 hover:bg-black/5 transition text-sm font-medium">
          About Me
        </a>
      </div>
    </div>

    <!-- Visual zone -->
    <div class="relative overflow-hidden bg-linear-to-b from-sky-400 to-sky-600 flex items-start p-8">
      <img src="/images/caustics.svg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-80 pointer-events-none" />
    </div>

  </div>
</section>