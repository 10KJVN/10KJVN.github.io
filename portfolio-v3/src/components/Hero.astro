---
---

<section class="relative left-1/2 -translate-x-1/2 w-screen min-h-screen overflow-hidden">
  <div class="grid md:grid-cols-[37%_63%] min-h-screen"> <!-- cols-2 = 50%, but [37%_63%] is manual -->

    <!-- Void zone (merged About teaser) -->
    <div class="relative flex flex-col justify-center px-16 py-16 hero-gradient text-text">

      <!-- hero-eyebrow -->
      <span class="relative z-10 text-sm uppercase tracking-widest px-1 py-1 rounded-full border border-chrome/10 bg-background/5 text-text w-fit">
        Game Developer ❖ Technical Artist
      </span>

      <!-- hero-name -->
      <h1 class="font-display mt-6 text-6xl leading-none">
        JAHVAIRO <br /> MONKAU
      </h1>
      <span class="font-mono text-xs">002 / ATMOS DNB</span>

      <!-- hero-subtitle-block -->
      <p class="font-sans mt-4 text-lg text-text/70">
        Code-driven aesthetics.
      </p>

      <!-- hero-description -->
      <p class="font-sans mt-4 max-w-md text-text/70 leading-relaxed">
        Inspired by stylized rendering and unique visual identities,
        I craft games through gameplay, design and graphics.
      </p>

      <!-- hero-cta's -->
      <div class="font-mono mt-8 flex gap-4">
        <a href="/#featured" class="px-5 py-2 rounded-md bg-primary hover:bg-primary/85 transition text-sm font-medium text-white">
          View My Work
        </a>
        <a href="/about" class="px-5 py-2 rounded-md bg-ice hover:bg-ice/85 transition text-sm font-medium text-white">
          About Me
        </a>

      </div>
    </div>

    <!-- Visual zone -->
    <div class="relative overflow-hidden bg-linear-to-b from-primary to-[#075985] flex items-start p-8">
      <img src="/images/caustics.svg" alt="" class="absolute inset-0 w-full h-full object-cover opacity-80 pointer-events-none" />
    </div>

  </div>
</section>