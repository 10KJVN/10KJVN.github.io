---
---

<section class="relative left-1/2 -translate-x-1/2 w-screen min-h-screen overflow-hidden">
  <div class="grid md:grid-cols-[37%_63%] min-h-screen"> <!-- cols-2 = 50%, but [37%_63%] is manual -->

    <!-- Void zone (merged About teaser) -->
    <div class="relative flex flex-col justify-center px-8 py-16 lg:px-12 xl:px-16 hero-gradient text-text">

      <!-- hero-eyebrow -->
      <span class="relative z-10 text-xs sm:text-sm uppercase tracking-wider sm:tracking-widest px-1 py-1 rounded-full border border-chrome/10 bg-background/5 text-text w-fit">
        Game Developer ❖ Technical Artist
      </span>

      <!-- hero-name -->
      <h1 class="font-display mt-6 text-6xl md:text-[clamp(2.75rem,6.2vw,3.75rem)] leading-none">
        JAHVAIRO <br /> MONKAU
      </h1>
      <span class="font-mono text-xs text-warm">002 / ATMOS DNB</span>

      <!-- hero-subtitle-block -->
      <p class="font-sans mt-4 text-lg text-text/80">
        Code-driven aesthetics.
      </p>

      <!-- hero-description -->
      <p class="font-sans mt-4 max-w-md text-text/90 leading-relaxed">
        Inspired by stylized rendering and unique visual identities,
        I craft games through gameplay, design and graphics.
      </p>

      <!-- hero-cta's -->
      <div class="font-mono mt-8 flex gap-4"> <!-- intentional blue -> purple on CTA clr scheme -->
        <!-- Primary: solid accent with a glow. Secondary: outline only, so the two never compete. -->
        <a href="/#featured" class="px-5 py-2 rounded-md cta-sheen bg-accent text-on-accent hover:brightness-110 transition text-sm font-medium">
          View My Work →
        </a>
        <a href="/about" class="px-5 py-2 rounded-md border border-border-strong text-text hover:border-accent hover:text-accent transition text-sm font-medium">
          About Me
        </a>

      </div>
    </div>

    <!-- Visual zone -->
    <!-- The caustics SVG has its own dark base. Screen blending drops that out so the panel's gradient shows
         through and only the light rays add brightness: icy and overexposed in light, a distant blue glow in dark. -->
    <div class="chrome-edge relative overflow-hidden bg-linear-to-b from-primary to-[#D6EEFB] dark:from-[#26396B] dark:to-[#090B12] flex items-start p-8">
      <img loading="lazy" decoding="async" src="/images/caustics.svg" alt="" class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-90 dark:opacity-55 pointer-events-none" />
    </div>

  </div>
</section>