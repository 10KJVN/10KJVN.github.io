---
interface TimelineLink {
    label: string;
    url: string;
}

interface TimelineEntry {
    title: string;
    description: string;
    /** A single link. Still works, so existing entries need no changes. */
    link?: TimelineLink;
    /** Several links, shown side by side. */
    links?: TimelineLink[];
}

interface TimelineGroup {
    year: string;
    entries: TimelineEntry[];
}

interface Props {
    groups: TimelineGroup[];
}

const { groups } = Astro.props;
// `link` and `links` both work; this turns either one into a single list.
const linksOf = (entry: TimelineEntry): TimelineLink[] => entry.links ?? (entry.link ? [entry.link] : []);
---

<!--
  Layout: a year column on the left, a continuous rule with one dot per year, and the entries to the right.
  Entries stack in a single column, newest first, so the reading order is always top to bottom.
-->
<ol>
    {groups.map((group) => (
            <li class="group grid md:grid-cols-[6.5rem_minmax(0,1fr)]">
                <h3 class="pb-4 font-display text-3xl font-medium leading-none tracking-wide text-accent md:pb-0 md:pt-0.5">
                    {group.year}
                </h3>

                <div class="relative ml-1 border-l border-border-strong pb-12 pl-6 group-last:border-transparent group-last:pb-0 md:ml-0 md:pl-10">
                    <span
                            aria-hidden="true"
                            class="absolute -left-[6px] top-[5px] h-[11px] w-[11px] rounded-full border-2 border-accent bg-background"
                    ></span>

                    <ul class="grid gap-y-9">
                        {group.entries.map((entry) => (
                                <li class="max-w-2xl">
                                    <h4 class="mb-1.5 text-lg font-semibold leading-snug text-text/90">{entry.title}</h4>
                                    <p class="text-sm leading-relaxed text-text/70">{entry.description}</p>
                                    {linksOf(entry).length > 0 && (
                                            <div class="mt-2 flex flex-wrap gap-x-5 gap-y-1">
                                                {linksOf(entry).map((link: TimelineLink) => (
                                                        <a href={link.url} class="text-sm text-accent hover:underline">
                                                            {link.label} &rarr;
                                                        </a>
                                                ))}
                                            </div>
                                    )}
                                </li>
                        ))}
                    </ul>
                </div>
            </li>
    ))}
</ol>
