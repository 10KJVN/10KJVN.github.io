---
interface Props {
    title: string;
    /** Optional decorative index, e.g. "01". */
    index?: string;
}

const { title, index } = Astro.props;
---

<header class="mb-10">
    {index && <p class="label mb-2 text-accent">{index}</p>}
    <h2 class="font-display text-4xl font-medium uppercase tracking-wide text-text">
        {title}
    </h2>
    <div class="ruler mt-4" aria-hidden="true"></div>
</header>