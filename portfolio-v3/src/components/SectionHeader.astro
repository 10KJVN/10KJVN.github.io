---
interface Props {
    title: string;
    subtitle?: string;
    centered?: boolean;
    as?: 'h1' | 'h2';
    class?: string;
}

const {
    title,
    subtitle,
    centered = false,
    as: Heading = 'h2',
    class: className = '',
} = Astro.props;
---

<div class={`mb-8 ${centered ? 'text-center' : ''} ${className}`}>
    <Heading class="font-display text-4xl font-medium uppercase tracking-wide text-text">
        {title}
    </Heading>
    {subtitle && (
            <p class="mt-2 text-text/70 text-base sm:text-lg">
                {subtitle}
            </p>
    )}
</div>