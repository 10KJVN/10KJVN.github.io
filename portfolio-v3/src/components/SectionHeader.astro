---
interface Props {
    title: string;
    subtitle?: string;
    centered?: boolean;
    as?: 'h1' | 'h2' | 'h3';
    class?: string;
}

const {
    title,
    subtitle,
    centered = false,
    as: Tag = 'h2',
    class: className = '',
} = Astro.props;
---

<div class={`mb-8 ${centered ? 'text-center' : ''} ${className}`}>
    <Tag class="text-2xl font-bold tracking-tight text-text sm:text-3xl">
        {title}
    </Tag>
    {subtitle && (
            <p class="mt-2 text-text/70 text-base sm:text-lg">
                {subtitle}
            </p>
    )}
</div>