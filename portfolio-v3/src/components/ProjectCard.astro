---
import Img from "./Img.astro";

interface Props {
    /** Above-the-fold cards load their image immediately; the rest are lazy. */
    priority?: boolean;
    title: string;
    description: string;
    image: string;
    href: string;
    tags?: string[];
    highlight?: boolean;
    size?: "regular" | "wide"; /** "regular" is the default. "wide" is a larger treatment; the parent decides where it is used and how wide it gets. */
    class?: string;
}

const {
    priority = false,
    title,
    description,
    image,
    href,
    tags = [],
    highlight = false,
    size = "regular",
    class: className = "",
} = Astro.props;

const isExternal: boolean = href.startsWith("http");

// Full literal class strings so Tailwind can detect them.
// Below lg the parent stacks everything in one column, so wide is a normal 16:9 card.
// From lg up the parent gives it a track ~2x as wide, so the image goes 32:9 (2 x 16:9) to keep the same height.
// I've made it 16/6 which makes it equal on 1.5fr, change to 16/5.2 when making 1.75fr.
const sizes = {
    regular: { title: "text-xl" },
    wide: { title: "text-xl lg:text-2xl" },
}[size];
---

<a href={href}
   target={isExternal ? "_blank" : undefined}
   rel={isExternal ? "noopener noreferrer" : undefined}
   data-tags={tags.join(",")}
   class={`rounded-frame transition border hover:shadow-[0_0_48px_var(--glow)] group block overflow-hidden
    ${highlight 
      ? "border-primary/40 bg-surface hover:bg-surface-alt" 
      : "border-border bg-surface hover:bg-surface-alt"
    } ${className}`}
>
    <div class="aspect-video overflow-hidden">
        <Img src={image}
             alt=""
             class="w-full h-full object-cover transition duration-300 group-hover:scale-105"
             loading={priority ? "eager" : "lazy"}
             fetchpriority={priority ? "high" : undefined}
             sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        />
    </div>

  <div class="p-5">
    <!-- h2: cards sit directly under the page's h1, so h3 would skip a level. -->
    <h2 class={`${sizes.title} font-semibold mb-2`}>{title}</h2>
      <p class="opacity-70 text-sm leading-relaxed mb-3">{description}</p>

      {tags.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                  {tags.map((tag) => (
                          <span class="text-[11px] uppercase tracking-wide px-2 py-0.5 rounded-full border border-border text-muted">
            {tag}
          </span>
                  ))}
              </div>
      )}
  </div>

{isExternal && <span class="sr-only">(opens in a new tab)</span>}

</a>
