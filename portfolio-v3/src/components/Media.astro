---
interface Props {
    src: string;
    alt: string;
    caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-8">
    <img src={src} alt={alt} class="m-0 w-full rounded-frame border border-border" />
    {caption && (
            <figcaption class="label mt-2">
                {caption}
            </figcaption>
    )}
</figure>