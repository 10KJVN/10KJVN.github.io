---
interface Props {
    src: string;
    alt: string;
    caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="my-8">
    <img src={src} alt={alt} class="m-0 w-full rounded-2xl border border-border" />
    {caption && (
            <figcaption class="mt-2 font-mono text-[10px] uppercase tracking-[0.2em] text-muted">
                {caption}
            </figcaption>
    )}
</figure>