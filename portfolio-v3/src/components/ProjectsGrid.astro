---
import ProjectCard from "./ProjectCard.astro";

interface Project {
    title: string;
    description: string;
    image: string;
    href: string;
    tags?: string[];
    highlight?: boolean;
}

interface Props {
    projects: Project[];
}

const { projects } = Astro.props;
---

<!-- removed md:grid-cols-3 here for tablet compatibility -->
<div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
    {projects.map((project) => (
            <ProjectCard
                    title={project.title}
                    description={project.description}
                    image={project.image}
                    href={project.href}
                    tags={project.tags}
                    highlight={project.highlight}
            />
    ))}
</div>
