---
interface Props {
    cols?: 2 | 3 | 4;
}

const { cols = 3 } = Astro.props;

const columns = { 2: "lg:grid-cols-2", 3: "lg:grid-cols-3", 4: "lg:grid-cols-4" }[cols];
---

<div
        class={`my-8 grid grid-cols-1 gap-4 sm:grid-cols-2 ${columns} [&>img]:m-0 [&>figure]:my-0 [&>img]:h-full [&>img]:w-full [&>img]:object-cover`}
>
    <slot />
</div>