---
import ThemeToggle from "./ThemeToggle.astro";

const path: string = Astro.url.pathname;

// "page" for the current section: /projects/dirt-jam keeps Projects current, "/" only matches Home.
const current = (href: string): "page" | undefined => {
  const here: string = path.replace(/\/$/, "") || "/";
  const match: boolean = href === "/" ? here === "/" : here === href || here.startsWith(`${href}/`);
  return match ? "page" : undefined;
};
---

<nav aria-label="Primary" class="fixed left-0 top-0 z-50 w-full border-b border-border bg-background/75 backdrop-blur-lg">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
    <!-- Brand, TODO: Realign to be left of navbar -->
    <a
        href="/"
        class="shrink-0 text-xl font-semibold tracking-wide transition hover:opacity-80"
    >
      JVN
    </a>

    <!-- Navigation links -->
    <ul
        id="nav-links"
        class="absolute left-0 top-full hidden w-full flex-col gap-4 border-b border-border bg-background px-6 py-6 text-sm uppercase tracking-wide md:static md:flex md:w-auto md:flex-row md:items-center md:gap-6 md:border-0 md:bg-transparent md:p-0"
    >
      <li><a class="nav-link" href="/" aria-current={current("/")}>Home</a></li>
      <li><a class="nav-link" href="/about" aria-current={current("/about")}>About</a></li>
      <li><a class="nav-link" href="/features" aria-current={current("/features")}>Features</a></li>
      <li><a class="nav-link" href="/projects" aria-current={current("/projects")}>Projects</a></li>
      <li><a class="nav-link" href="/contact" aria-current={current("/contact")}>Contact</a></li>
    </ul>

    <!-- TODO: find out whether i want to swap positions of middle and right aligned between theme switch and nav items. -->

    <!-- Theme and mobile controls -->
    <div class="flex shrink-0 items-center gap-2 md:ml-6">
      <ThemeToggle />

      <button
          id="nav-toggle"
          type="button"
          class="-mr-2 rounded-md p-2 md:hidden"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="nav-links"
      >
        <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            width="24"
            height="24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
        >
          <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById("nav-toggle");
  const links = document.getElementById("nav-links");

  if (toggle && links) {
    const nav = toggle.closest("nav");

    const setOpen = (open: boolean): void => {
      links.classList.toggle("hidden", !open);
      links.classList.toggle("flex", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    const isOpen = (): boolean => toggle.getAttribute("aria-expanded") === "true";

    toggle.addEventListener("click", () => {
      setOpen(!isOpen());
    });

    links.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    // Escape closes the menu and returns focus to the button that opened it.
    document.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "Escape" && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });

    // A click outside the navbar closes it. The theme toggle and brand sit inside the navbar, so they don't.
    document.addEventListener("click", (event: MouseEvent) => {
      if (isOpen() && nav && !nav.contains(event.target as Node)) setOpen(false);
    });

    // Reset mobile menu state when returning to desktop layout.
    const desktop = window.matchMedia("(min-width: 768px)");

    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .nav-link {
    position: relative;
    padding-bottom: 2px;
    transition: color 0.2s ease;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.25s ease;
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 100%;
  }

  /* Mobile dropdown only: taller tap targets. Desktop nav is unchanged. */
  @media (max-width: 767px) {
    .nav-link {
      display: inline-block;
      padding-block: 0.625rem; /* 20px line + 20px padding = 40px tall. Lower it to tighten the menu. */
    }

    .nav-link::after {
      bottom: 0.5rem; /* keeps the underline close to the text */
    }
  }
</style>