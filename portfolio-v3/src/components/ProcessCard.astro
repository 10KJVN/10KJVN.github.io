---
interface Props {
    title: string;
    image?: string;
}

const { title, image } = Astro.props;
---

<div class="flex-1">
    <slot name="media">
        {image && (
                <div class="rounded-2xl overflow-hidden shadow-xl mb-4">
                    <img src={image} alt={title} class="w-full h-auto object-cover" />
                </div>
        )}
    </slot>

    <h4 class="text-lg font-semibold mb-2 text-white/90">{title}</h4>
    <div class="text-white/70 leading-relaxed text-sm space-y-2">
        <slot />
    </div>
</div>