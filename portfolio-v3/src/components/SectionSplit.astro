---
// Props:
//
// title: string
// text: string | Astro component
// image: string (optional)
// reverse: boolean (optional, swaps image/text sides)

const { title, text, image, reverse = false } = Astro.props;
---

<section class="py-32 bg-[#0d1117]">
  <div class={`max-w-6xl mx-auto grid md:grid-cols-2 gap-20 px-6 
      ${reverse ? "md:flex-row-reverse" : ""}`}
  >
    <!-- Text -->
    <div class="flex flex-col justify-center">
      <h2 class="text-5xl font-semibold mb-8 font-serif tracking-tight">
        {title}
      </h2>

      <div class="text-white/70 leading-relaxed space-y-4 text-lg">
        {text}
      </div>
    </div>

    <!-- Image -->
    {image && (
      <div class="rounded-2xl overflow-hidden shadow-xl">
        <img src={image} alt={title} class="w-full h-auto object-cover" />
      </div>
    )}
  </div>
</section>
