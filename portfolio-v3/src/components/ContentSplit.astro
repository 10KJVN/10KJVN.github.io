---
interface Props {
    title?: string;
    image?: string;
    reverse?: boolean;
}

const { title, image, reverse = false } = Astro.props;
---

<div class={`flex flex-col md:flex-row md:items-center gap-8 md:gap-12 my-10 ${reverse ? "md:flex-row-reverse" : ""}`}>
    <div class="flex-1">
        {title && <h3 class="text-xl font-semibold mb-3 text-white/90">{title}</h3>}
        <div class="text-white/70 leading-relaxed space-y-4">
            <slot />
        </div>
    </div>

    <div class="flex-1">
        <slot name="media">
            {image && (
                    <div class="rounded-2xl overflow-hidden shadow-xl">
                        <img src={image} alt={title ?? ""} class="w-full h-auto object-cover" />
                    </div>
            )}
        </slot>
    </div>
</div>