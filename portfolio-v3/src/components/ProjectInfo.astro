---
const { year, duration, engine, language, teamSize, role, description } = Astro.props;

const stats = [
    { label: "Year", value: year },
    { label: "Duration", value: duration },
    { label: "Engine", value: engine },
    { label: "Language", value: language },
    { label: "Team Size", value: teamSize },
    { label: "Role", value: role },
].filter((s) => s.value);
---

<section class="border border-white/10 rounded-2xl p-6 mb-8">
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-6 mb-6">
        {stats.map((s) => (
                <div>
                    <p class="text-xs uppercase tracking-wide text-white/40 mb-1">{s.label}</p>
                    <p class="text-sm text-white/80">{s.value}</p>
                </div>
        ))}
    </div>
    {description && <p class="text-white/70 leading-relaxed">{description}</p>}
</section>