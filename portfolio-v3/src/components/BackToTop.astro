<button
        id="back-to-top"
        type="button"
        aria-label="Back to top"
        inert
        class="fixed bottom-6 right-6 px-4 py-2.5 rounded-full border border-border-strong bg-surface/90 backdrop-blur text-sm font-medium text-text shadow-[0_0_20px_var(--glow)] hover:border-accent hover:text-accent transition opacity-0 pointer-events-none"
>
    ↑ Top
</button>

<script>
    const btn = document.getElementById("back-to-top");
    const reduceMotion: MediaQueryList = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (btn) {
        const update = (): void => {
            const show: boolean = window.scrollY > 600;
            btn.classList.toggle("opacity-0", !show);
            btn.classList.toggle("pointer-events-none", !show);
            // `inert` removes the button from the tab order and the accessibility tree while it is hidden.
            btn.toggleAttribute("inert", !show);
        };

        window.addEventListener("scroll", update, { passive: true });
        update();

        btn.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: reduceMotion.matches ? "auto" : "smooth" });
            // The button is about to disappear, so park keyboard focus on the page content.
            document.getElementById("main")?.focus({ preventScroll: true });
        });
    }
</script>