---
interface Props {
    title: string;
    description: string;
    image: string;
    href: string;
    eyebrow?: string;
    tags?: string[];
    class?: string;
    index?: number;
}

const {
    title,
    description,
    image,
    href,
    eyebrow,
    tags = [],
    class: className = "",
    index
} = Astro.props;
---

<a
        href={href}
        class={`group grid overflow-hidden rounded-2xl border border-border bg-surface transition
        hover:border-primary/40 hover:bg-surface-alt ${className}`}
>
    <div class="aspect-video overflow-hidden">
        <img
                src={image}
                alt={title}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
        />
    </div>

    <div class="flex flex-col justify-between gap-6 p-6 lg:p-8">

        <div>
            {eyebrow && (
                    <span class="font-mono text-[10px] uppercase tracking-[0.2em] opacity-50">
                    {eyebrow}
                </span>
            )}

            <h3 class="mt-2 text-2xl font-semibold tracking-tight">
                {title}
            </h3>

            <p class="mt-3 max-w-xl text-sm leading-relaxed opacity-65">
                {description}
            </p>
        </div>

        <div class="flex items-end justify-between gap-4">
            <div class="flex flex-wrap gap-2">
                {tags.map((tag) => (
                        <span class="rounded-full border border-border px-2.5 py-1 font-mono text-[10px] uppercase tracking-wide opacity-60">
                        {tag}
                    </span>
                ))}
            </div>

            <span class="shrink-0 text-sm transition-transform group-hover:translate-x-1">
                View breakdown →
            </span>
        </div>

    </div>
</a>