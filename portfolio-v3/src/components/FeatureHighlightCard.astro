---
interface Props {
    title: string;
    description: string;
    image: string;
    href: string;
    tags?: string[];
    index?: number;
    eyebrow?: string;
}

const { title, description, image, href, tags = [], index, eyebrow } = Astro.props;
---

<a
        href={href}
        class="group block border border-border rounded-2xl overflow-hidden bg-surface hover:border-text transition"
>
    <div class="aspect-video overflow-hidden relative">
        <img
                src={image}
                alt={title}
                class="w-full h-full object-cover transition duration-300 group-hover:scale-105"
        />
        {index != null && (
                <span class="absolute top-3 right-3 font-mono text-[10px] uppercase tracking-wide text-text bg-surface/80 px-2 py-0.5 rounded-full border border-border">
        N&deg;{String(index).padStart(3, "0")}
      </span>
        )}
    </div>
    <div class="p-6">
        {eyebrow && (
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] opacity-50">
        {eyebrow}
      </span>
        )}
        <h3 class="text-xl font-semibold mt-1 mb-2 text-text">{title}</h3>
        <p class="text-sm mb-4 text-text/70">{description}</p>
        <!--{tags.length > 0 && (-->
        <!--        <div class="flex flex-wrap gap-1.5 mb-4">-->
        <!--            {tags.map((tag) => (-->
        <!--                    <span class="text-[11px] uppercase tracking-wide px-2 py-0.5 rounded-full border border-border text-text/70">-->
        <!--    {tag}-->
        <!--  </span>-->
        <!--            ))}-->
        <!--        </div>-->
        <!--)}-->
        <span class="text-primary group-hover:underline text-sm">Read breakdown &rarr;</span>
    </div>
</a>