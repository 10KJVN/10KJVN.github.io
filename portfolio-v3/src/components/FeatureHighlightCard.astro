---
interface Props {
    title: string;
    description: string;
    image: string;
    href: string;
    tags?: string[];
    index?: number;
    eyebrow?: string;
}

const { title, description, image, href, tags = [], index, eyebrow } = Astro.props;
---

<a
        href={href}
        class="group block overflow-hidden rounded-2xl border border-border bg-surface transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_0_32px_rgba(166,225,250,0.15)]"
>
    <div class="aspect-video overflow-hidden relative">
        <img
                src={image}
                alt={title}
                class="w-full h-full object-cover transition duration-300 group-hover:scale-105"
        />

        {index != null && (<span class="absolute top-3 right-3 font-mono text-[10px] uppercase tracking-wide text-text bg-surface/80 px-2 py-0.5 rounded-full border border-border">
        N&deg;{String(index).padStart(3, "0")}
      </span> )}

    </div>
    <div class="p-6 md:p-7">
        {eyebrow && (<p class="font-mono text-[10px] uppercase tracking-[0.25em] opacity-50"> {eyebrow} </p> )}

        <!--<h3 class="text-xl font-semibold mt-1 mb-2 text-text">{title}</h3>-->
        <div class="mt-2 flex items-start justify-between gap-6">
            <h3 class="font-display text-2xl uppercase tracking-wide">
                {title}
            </h3>

            <!--<span class="font-mono text-xs opacity-35 transition group-hover:translate-x-1 group-hover:opacity-70">-->
            <!--    ↗-->
            <!--</span>-->
        </div>

        <p class="mt-3 max-w-xl text-sm leading-relaxed opacity-60">
            {description}
        </p>

        <!--<p class="text-sm mb-4 text-text/70">{description}</p>-->

        <!--<span class="text-primary group-hover:underline text-sm">Read breakdown &rarr;</span>-->
        <div class="mt-6 border-t border-border pt-4">
            <span class="font-mono text-[10px] uppercase tracking-[0.15em] opacity-50 transition group-hover:opacity-90">
                Read full breakdown →
            </span>
        </div>
    </div>
</a>