---
import Layout from "../../layouts/Layout.astro";
import ProjectInfo from "../../components/ProjectInfo.astro";
import ProjectLinks from "../../components/ProjectLinks.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
    const features = await getCollection("features");

    // Only standalone features get a real page — anchored and external ones resolve elsewhere.
    const standalone = features.filter(
        (f) => !f.data.externalUrl && !(f.data.projectSlug && f.data.anchorId)
    );

    return standalone.map((feature) => ({
        params: { slug: feature.id },
        props: { feature },
    }));
}

interface Props {
    feature: CollectionEntry<"features">;
}

const { feature } = Astro.props;
const { Content } = await render(feature);

const projects = await getCollection("projects");

const parentProject = feature.data.projectSlug
    ? projects.find((project) => project.id === feature.data.projectSlug)
    : undefined;
---

<Layout
        title={`${feature.data.title} | Jahva's Portfolio`}
        description={feature.data.description}
>
    <article class="mx-auto max-w-[1200px] px-8 py-16 lg:px-12">

        <Breadcrumb
                trail={
                    parentProject
                        ? [
                            { label: "Projects", href: "/projects" },
                            {
                                label: parentProject.data.title,
                                href: `/projects/${parentProject.id}`
                            },
                            { label: feature.data.title }
                        ]
                        : [
                            { label: "Features", href: "/features" },
                            { label: feature.data.title }
                        ]
                }
        />

        <header class="mx-auto max-w-4xl">
            <p class="font-mono text-[10px] uppercase tracking-[0.25em] opacity-45">
                Feature · {feature.data.year}
            </p>

            <h1 class="mt-4 font-display text-5xl uppercase tracking-wide md:text-7xl">
                {feature.data.title}
            </h1>

            <!-- This might need refactoring into a component so i can optionally leave out certain metadata per unique feature case.-->
            <div class="mt-8 flex flex-wrap gap-x-6 gap-y-2 border-y border-border py-4">
            <span class="font-mono text-[10px] uppercase opacity-50">
                {feature.data.year}
            </span>

                {feature.data.duration && (
                        <span class="font-mono text-[10px] uppercase opacity-50">
                            {feature.data.duration}
                        </span>
                )}

                <!-- Octo and Radial don't need this for example, its sort of the child feature of a project tagged with Unity -->
                {feature.data.engine && (
                        <span class="font-mono text-[10px] uppercase opacity-50">
                            {feature.data.engine}
                        </span>
                )}

                {feature.data.language && (
                        <span class="font-mono text-[10px] uppercase opacity-50">
                            {feature.data.language}
                        </span>
                )}

                {feature.data.teamSize && (
                        <span class="font-mono text-[10px] uppercase opacity-50">
                            {feature.data.teamSize}
                        </span>
                )}

                {feature.data.role && (
                        <span class="font-mono text-[10px] uppercase opacity-50">
                            {feature.data.role}
                        </span>
                )}
            </div>

            <p class="mt-4 max-w-2xl text-base leading-relaxed opacity-60 md:text-lg">
                {feature.data.description}
            </p>

            <!-- Hero -->
            <figure class="mx-auto mt-14 max-w-6xl overflow-hidden rounded-2xl border border-border">
                <img
                        src={feature.data.thumbnail}
                        alt={feature.data.title}
                        class="w-full"
                />
            </figure>

            <!--<ProjectInfo-->
            <!--        duration={feature.data.duration}-->
            <!--        teamSize={feature.data.teamSize}-->
            <!--        role={feature.data.role}-->
            <!--/>-->

        </header>


        <!--<ProjectLinks links={feature.data.links} />-->

        <div class="mdx-content">
            <Content />
        </div>

        {parentProject ? (
                <a href={`/projects/${parentProject.id}`}
                   class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.15em] opacity-50 transition hover:opacity-100">
                    ← Back to {parentProject.data.title}
                </a>
        ) : (
                <a href="/features"
                   class="inline-flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.15em] opacity-50 transition hover:opacity-100">
                    ← Back to Features
                </a>
        )}

    </article>
</Layout>

<style>
    .mdx-content :global(h2) {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--color-text);
        margin-top: 3rem;
        margin-bottom: 1rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(26, 43, 60, 0.15);
    }

    .mdx-content :global(h3) {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--color-text);
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .mdx-content :global(p) {
        color: var(--color-text);
        line-height: 1.75;
        margin-bottom: 1rem;
        max-width: 68ch;
    }

    .mdx-content :global(ul),
    .mdx-content :global(ol) {
        color: var(--color-text);
        line-height: 1.75;
        margin-bottom: 1rem;
        padding-left: 1.5rem;
        max-width: 68ch;
    }

    .mdx-content :global(ul) {
        list-style: disc;
    }

    .mdx-content :global(a) {
        color: var(--color-text);
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .mdx-content :global(img),
    .mdx-content :global(video) {
        border-radius: 1rem;
        margin: 1.5rem 0;
        max-width: 100%;
    }

    .mdx-content :global(code) {
        background: rgba(26, 43, 60, 0.08);
        padding: 0.15rem 0.4rem;
        border-radius: 0.35rem;
        font-size: 0.85em;
    }

    .mdx-content :global(pre) {
        background: #E8F1F8;
        border: 1px solid rgba(26, 43, 60, 0.12);
        border-radius: 0.75rem;
        padding: 1rem;
        overflow-x: auto;
        margin-bottom: 1.5rem;
    }

    .mdx-content :global(pre code) {
        background: none;
        padding: 0;
    }
</style>