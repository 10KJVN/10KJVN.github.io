---
import Layout from "../../layouts/Layout.astro";
import Img from "../../components/Img.astro";
import HeroMeta from "../../components/HeroMeta.astro";
import ProjectInfo from "../../components/ProjectInfo.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import HeadingLinks from "../../components/HeadingLinks.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import BackToTop from "../../components/BackToTop.astro";
import PageEndNav from "../../components/PageEndNav.astro";
import { getPageNav } from "../../lib/pageNav";
import { isPublished } from "../../lib/content";

export async function getStaticPaths() {
    const features = await getCollection("features");

    // Only standalone features get a real page — anchored and external ones resolve elsewhere.
    const standalone = features.filter(
        (f) => !f.data.externalUrl && !(f.data.projectSlug && f.data.anchorId)
    );

    return standalone.map((feature) => ({
        params: { slug: feature.id },
        props: { feature },
    }));
}

interface Props {
    feature: CollectionEntry<"features">;
}

const { feature } = Astro.props;
const { Content, headings } = await render(feature);

const projects = await getCollection("projects", isPublished);

const parentProject = feature.data.projectSlug
    ? projects.find((project) => project.id === feature.data.projectSlug)
    : undefined;

const nav = await getPageNav("feature", feature.id);
---

<Layout
        title={`${feature.data.title} | Jahva's Portfolio`}
        description={feature.data.description}
        width="wide"
>
    <article class="mx-auto max-w-[1600px] px-8 py-16 lg:px-12 xl:px-16">

        <Breadcrumb
                trail={
                    parentProject
                        ? [
                            { label: "Projects", href: "/projects" },
                            {
                                label: parentProject.data.title,
                                href: `/projects/${parentProject.id}`
                            },
                            { label: feature.data.title }
                        ]
                        : [
                            { label: "Features", href: "/features" },
                            { label: feature.data.title }
                        ]
                }
        />

        <header class="mx-auto max-w-4xl">
            <p class="label">
                Feature · {feature.data.year}
            </p>

            <h1 class="mt-4 font-display text-5xl uppercase tracking-wide md:text-7xl">
                {feature.data.title}
            </h1>

            <!-- Per feature: infoTitle / infoHide in the front matter (e.g. infoHide: ["engine"] for a child feature
                 whose engine is obvious from its project). Year is left out: the eyebrow above already shows it. -->
            <ProjectInfo
                    class="mt-8"
                    role={feature.data.role}
                    teamSize={feature.data.teamSize}
                    duration={feature.data.duration}
                    engine={feature.data.engine}
                    language={feature.data.language}
                    title={feature.data.infoTitle}
                    hide={[...feature.data.infoHide, "year"]}
            />

            <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
                {feature.data.description}
            </p>

        </header>

        <!-- Keep the title and summary readable while allowing the hero and MDX compositions to use the wider canvas. -->
        <figure class="mx-auto mt-14 max-w-[1440px] overflow-hidden rounded-frame border border-border crop-marks">
            <Img src={feature.data.thumbnail} alt={feature.data.title} class="w-full" loading="eager" fetchpriority="high" sizes="(min-width: 1440px) 1440px, 100vw" />
        </figure>

        <!-- Tags left, links right. Both optional. -->
        <HeroMeta class="mx-auto mt-3 max-w-[1440px]" tags={feature.data.tags} links={feature.data.links} />

        <div class="mt-16">
            <TableOfContents headings={headings}>
                <div class="mdx-content">
                    <Content />
                </div>
            </TableOfContents>
        </div>
        <HeadingLinks />

        <PageEndNav left={nav.left} right={nav.right}>
            {parentProject ? (
                    <a href={`/projects/${parentProject.id}`}
                       class="inline-flex items-center gap-2 label transition hover:text-text">
                        ← Back to {parentProject.data.title}
                    </a>
            ) : (
                    <a href="/features"
                       class="inline-flex items-center gap-2 label transition hover:text-text">
                        ← Back to Features
                    </a>
            )}
        </PageEndNav>

    </article>

    <BackToTop />
</Layout>