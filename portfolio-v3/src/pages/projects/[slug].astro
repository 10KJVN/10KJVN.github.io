---
/**
    * Generates a page for each project.
    *
    * Generates a page for each project in the content collection.
    * Project metadata comes from the collection, while the case-study
    * content is rendered from the project's MDX file.
    */

import Layout from "../../layouts/Layout.astro";
import Img from "../../components/Img.astro";
import HeroMeta from "../../components/HeroMeta.astro";
import ProjectInfo from "../../components/ProjectInfo.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import HeadingLinks from "../../components/HeadingLinks.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import FeatureHighlightCard from "../../components/FeatureHighlightCard.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { resolveFeatureHref } from "../../lib/resolveFeatureHref";
import BackToTop from "../../components/BackToTop.astro";
import PageEndNav from "../../components/PageEndNav.astro";
import { getPageNav } from "../../lib/pageNav";
import { isPublished } from "../../lib/content";

export async function getStaticPaths() {
    const projects = await getCollection("projects");
    return projects.map((project) => ({
        params: { slug: project.id },
        props: { project },
    }));
}

interface Props {
    project: CollectionEntry<"projects">;
}

const { project } = Astro.props;

const { Content, headings } = await render(project)

// Show every feature explicitly associated with this project, in its chosen order.
// The route should not silently hide content when a project has more than two features.
const allFeatures = await getCollection("features", isPublished);

const projectFeatures = allFeatures
    .filter((feature) => feature.data.projectSlug === project.id)
    .sort((a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity));

// One feature = it gets the whole row and the wide card. Two or more share the row as regular cards.
const singleFeature: boolean = projectFeatures.length === 1;

const nav = await getPageNav("project", project.id);
---

<Layout
        title={`${project.data.title} | Jahva's Portfolio`}
        description={project.data.description}
        width="wide"
>
    <article class="mx-auto max-w-[1600px] px-8 py-16 lg:px-12 xl:px-16">

        <Breadcrumb trail={[{ label: "Projects", href: "/projects" }, { label: project.data.title }]} />

        <!-- Project Header -->
        <header class="mx-auto max-w-5xl text-center">

            <p class="mt-3 label">
                Project · {project.data.year}
            </p>

            <h1 class="mt-4 font-display text-5xl uppercase tracking-wide md:text-7xl">
                {project.data.title}
            </h1>

            <p class="mx-auto mt-6 max-w-2xl text-base leading-relaxed text-muted md:text-lg">
                {project.data.description}
            </p>
        </header>

        <!-- Hero sits outside the header so it can use the wide canvas instead of the header's max-w-5xl.
             It is the page's largest image, so it loads immediately. -->
        <figure class="mx-auto mt-14 max-w-[1440px] overflow-hidden rounded-frame border border-border crop-marks">
            <Img src={project.data.thumbnail} alt={project.data.title} class="w-full" loading="eager" fetchpriority="high" sizes="(min-width: 1440px) 1440px, 100vw" />
        </figure>

        <!-- Tags left, links right. Both optional. -->
        <HeroMeta class="mx-auto mt-3 max-w-[1440px]" tags={project.data.tags} links={project.data.links} />

        <!-- Role / team / duration / engine / language. Per project: infoTitle, infoHide in the front matter.
             Year is left out here because the eyebrow above the title already shows it. -->
        <ProjectInfo
                class="mx-auto mt-3 max-w-[1440px]"
                role={project.data.role}
                teamSize={project.data.teamSize}
                duration={project.data.duration}
                engine={project.data.engine}
                language={project.data.language}
                title={project.data.infoTitle}
                hide={[...project.data.infoHide, "year"]}
        />

        <!-- Feature Showcase -->
        {projectFeatures.length > 0 && (
                <section class="mt-16">

                    <div class="mb-8 flex items-end justify-between">
                        <div>
                            <p class="label">
                                Selected Contributions
                            </p>

                            <h2 class="mt-2 text-3xl font-semibold tracking-tight">
                                What I built
                            </h2>
                        </div>
                    </div>

                    <div class={`grid gap-6 ${singleFeature ? "" : "lg:grid-cols-2"}`}>
                        {projectFeatures.map((feature) => (
                                <FeatureHighlightCard
                                        title={feature.data.title}
                                        description={feature.data.description}
                                        image={feature.data.thumbnail}
                                        href={resolveFeatureHref(feature)}
                                        tags={feature.data.tags}
                                        eyebrow={feature.data.tags[0]}
                                        size={singleFeature ? "wide" : "regular"}
                                />
                        ))}
                    </div>

                </section>
        )}


        <!-- Project narrative is authored in MDX so each project can choose its own structure. -->
        <!-- On long pages the article gets a persistent table of contents (see src/config.ts for the threshold). -->
        <div class="mt-20">
            <TableOfContents headings={headings}>
                <div class="mdx-content">
                    <Content />
                </div>
            </TableOfContents>
        </div>
        <HeadingLinks />

        <PageEndNav left={nav.left} right={nav.right} />

    </article>

    <BackToTop />
</Layout>