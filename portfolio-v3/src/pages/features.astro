---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FilterBar from "../components/FilterBar.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro"
import { getCollection } from "astro:content";
import { resolveFeatureHref } from "../lib/resolveFeatureHref";

const allFeatures = await getCollection("features")

const sorted = [...allFeatures].sort(
    (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity)
);

const features = sorted.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.thumbnail,
    href: resolveFeatureHref(entry),
    tags: entry.data.tags,
}));

// Order here = order of the filter pills. Every tag still shows on cards.
const FILTER_TAGS: string[] = ["Unity", "C#", "Unreal", "C++", "Godot", "Gameplay", "Shaders", "UI"];
const allTags: string[] = FILTER_TAGS.filter((tag) => features.some((f) => f.tags.includes(tag)));
---

<Layout title="Features | Jahva's Portfolio">
    <section class="py-24">
        <div class="max-w-5xl mx-auto px-6">
            <SectionHeader title="Features" />

            <FilterBar tags={allTags} />

            <ProjectsGrid projects={features} />
        </div>
    </section>
</Layout>