---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionSplit from "../components/SectionSplit.astro";
import SectionHeader from "../components/SectionHeader.astro";
import {getCollection} from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import { resolveFeatureHref } from "../lib/resolveFeatureHref";

const featuredProjects = (await getCollection("projects"))
    .filter((project) => project.data.highlight)
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const featuredFeatures = (await getCollection("features"))
    .filter((feature) => feature.data.highlight)

const skills = {
  Engine: [
    { name: "Unity", duration: "4 year" },
    { name: "Unreal", duration: "2 year" },
    { name: "Godot", duration: "1 month" },
  ],
  Language: [
    { name: "C#", duration: "4 year" },
    { name: "C++", duration: "0.5 year" },
    { name: "HLSL/GLSL", duration: "0.5 year" },
  ],
  Tools: [
    { name: "Git", duration: "5 year" },
    { name: "Rider", duration: "4 year" },
    { name: "Visual Studio Code", duration: "4 year" },
  ],
  Productivity: [
    { name: "Trello", duration: "4 year" },
    { name: "ChatGPT", duration: "3 year" },
    { name: "Obsidian", duration: "1 month" },
  ],
  Creative: [
    { name: "Blender", duration: "0.5 year" },
    { name: "Photoshop", duration: "0.5 year" },
  ],
};
---

<Layout
  title="Home | Jahva's Portfolio"
  description="Personal projects that showcase ideas and other technical achievements."
>
  <Hero />

  <!-- Highlighted Work -->
  <section class="py-28 border-t border-border-strong" id="featured">
    <div class="max-w-6xl mx-auto px-6">
      <SectionHeader title="Highlighted Work" />

      <div class="grid md:grid-cols-2 gap-12 mt-8">
        <!-- Projects column -->
        <div>
          <h3 class="text-sm uppercase tracking-wide text-white/50 mb-4">Projects</h3>
          <div class="flex flex-row gap-4">
            {featuredProjects.map((project) => (
                <ProjectCard
                    title={project.data.title}
                    description={project.data.description}
                    href={`/projects/${project.id}`}
                    image={project.data.thumbnail}
                />
            ))}
          </div>
        </div>

        <!-- Features column -->
        <div>
          <h3 class="text-sm uppercase tracking-wide text-white/50 mb-4">Features</h3>
          <div class="flex flex-row gap-4">
            {featuredFeatures.map((feature) => (
                <ProjectCard
                    title={feature.data.title}
                    description={feature.data.description}
                    image={feature.data.thumbnail}
                    href={resolveFeatureHref(feature)}
                    tags={feature.data.tags}
                />
            ))}
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- About Me (short teaser — full bio lives on /about) -->
  <section class="py-28 border-t border-border-strong">
    <SectionSplit title="About Me" image="/images/abtme.jpg">
      <p>
        I'm a technical artist and game developer focusing on rendering, shaders
        and gameplay systems.
      </p>
      <a href="/about" class="inline-block mt-4 text-sky-400 hover:text-sky-300 text-sm">
        Read more about me &rarr;
      </a>
    </SectionSplit>
  </section>
  
  <!-- Skills -->
  <section class="py-28 border-t border-border-strong">
    <div class="max-w-5xl mx-auto px-6">
      <SectionHeader title="Skills" />

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-10 mt-8">
        {Object.entries(skills).map(([category, items]) => (
            <div>
              <h3 class="text-sm uppercase tracking-wide text-white/50 mb-3">{category}</h3>
              <div class="flex flex-wrap gap-2">
                {items.map((item) => (
                    <span class="text-xs px-3 py-1 rounded-full border border-white/15 text-white/70">
                  {item.name} <span class="text-white/40">- {item.duration}</span>
                </span>
                ))}
              </div>
            </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
