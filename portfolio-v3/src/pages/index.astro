---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionHeader from "../components/SectionHeader.astro";
import {getCollection} from "astro:content";
import ProjectCard from "../components/ProjectCard.astro";
import { resolveFeatureHref } from "../lib/resolveFeatureHref";

const allProjects = (await getCollection("projects"))
    .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

// Left to right on the homepage. Independent of `order`, so the Projects page is unaffected.
const featuredSlugs: string[] = ["dirt-jam", "operation-starfall", "the-kermis"];
const featuredProjects = featuredSlugs.flatMap((slug) =>
    allProjects.filter((project) => project.id === slug)
);

// Optional short card text for the homepage only. Key = project slug.
// No entry (or an empty string) = the card shows the project's normal description.
const homeDescriptions: Partial<Record<string, string>> = {
  // "dirt-jam": "Your short card description goes here.",
};

const extraProjects = allProjects
    .filter((project) => !project.data.highlight)
    .slice(0, 2);
---

<Layout
  title="Home | Jahva's Portfolio"
  description="Personal projects that showcase ideas and other technical achievements."
>
  <Hero />

  <!-- Highlighted Work -->
  <section class="full-bleed py-28 border-t border-border-strong" id="featured">
    <div class="max-w-8xl mx-auto px-8 sm:px-16">
      <SectionHeader as="h1" title="Highlighted Work" />

      <div class="grid lg:grid-cols-1 gap-12 mt-8">
        <!-- Projects column -->
        <div>
          <!--<h3 class="label mb-4">Projects</h3>-->
          <div class="grid gap-4 lg:grid-cols-[1fr_1.75fr_1fr] 3xl:grid-cols-[1fr_1.5fr_1fr] items-center">
            {featuredProjects.map((project, i) => (
                <ProjectCard
                    title={project.data.title}  
                    description={homeDescriptions[project.id] || project.data.description}
                    href={`/projects/${project.id}`}
                    image={project.data.thumbnail}
                    tags={project.data.tags}
                    size={i === 1 ? "wide" : "regular"}
                />
            ))}
          </div>
        </div>

        <div class="mt-8 flex justify-center">
          <a href="/projects" class="rounded-md border border-border-strong bg-surface px-7 py-3 font-medium text-text transition hover:border-accent hover:text-accent glass-panel glow-soft">
            See more projects
          </a>
        </div>

      </div>
    </div>
  </section>
</Layout>