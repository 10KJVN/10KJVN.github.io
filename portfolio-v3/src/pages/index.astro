---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionSplit from "../components/SectionSplit.astro";
import SectionHeader from "../components/SectionHeader.astro";

const featuredProjects = [
  {
    title: "Way2Terrain",
    description:
      "Godot RenderingDevice terrain system — SPIR-V shaders, GPU pipelines, custom noise, LOD, tooling.",
    image: "/images/DirtJamThumb.png",
    href: "/projects/dirt-jam",
    highlight: true,
  },

  {
    title: "Operation Starfall",
    description:
      "Gameplay systems, shaders, rendering features & technical art contributions for a commercial project.",
    image: "/images/OctoThumb.png",
    href: "/projects/starfall",
    highlight: true,
  },

  {
    title: "The Ensemble",
    description: "interactive architectural visualization in Unreal Engine.",
    href: "/projects/ensemble",
    highlight: true,
  }
];

const featuredFeatures = [
  {
    title: "Shopify API",
    description:
        "Custom Shopify API integration built during an internship — duo project, C++.",
    href: "/features/shopify-api",
  },
  {
    title: "Octodrone",
    description:
        "Pair-programmed gameplay & shader feature shipped within Operation Starfall.",
    href: "/projects/starfall#octodrone",
  },
];
---

<Layout
  title="Portfolio | 10KJVN - Jahvairo Monkau"
  description="Personal projects that showcase ideas and other technical achievements."
>
  <Hero />

  <!-- Highlighted Work -->
  <section class="py-28 border-t border-white/10">
    <div class="max-w-6xl mx-auto px-6">
      <SectionHeader title="Highlighted Work" />

      <div class="grid md:grid-cols-2 gap-12 mt-8">
        <!-- Projects column -->
        <div>
          <h3 class="text-sm uppercase tracking-wide text-white/50 mb-4">Projects</h3>
          <div class="flex flex-col gap-4">
            {featuredProjects.map((p) => (

              <a href={p.href}
              class="group block rounded-xl border border-white/10 p-6 bg-white/2 hover:bg-white/5 transition"
                  >
                  <h4 class="text-lg font-semibold mb-1">{p.title}</h4>
                  <p class="text-white/60 text-sm">{p.description}</p>
              </a>
              ))}
          </div>
        </div>

        <!-- Features column -->
        <div>
          <h3 class="text-sm uppercase tracking-wide text-white/50 mb-4">Features</h3>
          <div class="flex flex-col gap-4">
            {featuredFeatures.map((f) => (

              <a href={f.href}
              class="group block rounded-xl border border-white/10 p-6 bg-white/2 hover:bg-white/5 transition"
                  >
                  <h4 class="text-lg font-semibold mb-1">{f.title}</h4>
                  <p class="text-white/60 text-sm">{f.description}</p>
              </a>
              ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- About Me (short teaser — full bio lives on /about) -->
  <SectionSplit title="About Me" image="/images/abtme.jpg">
    <p>
      I'm a technical artist and game developer focusing on rendering, shaders
      and gameplay systems.
    </p>
    <a href="/about" class="inline-block mt-4 text-sky-400 hover:text-sky-300 text-sm">
      Read more about me &rarr;
    </a>
  </SectionSplit>

  <!-- Skills -->
  <section class="py-28 border-t border-white/10">
    <div class="max-w-5xl mx-auto px-6">
      <SectionHeader title="Skills" />
      <p class="text-white/50 text-sm mt-4">
        Placeholder
      </p>
    </div>
  </section>
</Layout>
