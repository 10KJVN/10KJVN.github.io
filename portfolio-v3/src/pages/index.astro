---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import SectionSplit from "../components/SectionSplit.astro";
import SectionHeader from "../components/SectionHeader.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";
import ProjectsSection from "../components/ProjectsSection.astro";

const featuredProjects = [
  {
    title: "Way2Terrain",
    description:
      "Godot RenderingDevice terrain system — SPIR-V shaders, GPU pipelines, custom noise, LOD, tooling.",
    image: "/images/DirtJamThumb.png",
    href: "/projects/dirt-jam",
    highlight: true,
  },
  {
    title: "Operation Starfall",
    description:
      "Gameplay systems, shaders, rendering features & technical art contributions for a commercial project.",
    image: "/images/OctoThumb.png",
    href: "/projects/starfall",
    highlight: true,
  },
];

const otherProjects = [
  {
    title: "URP — Rendering & Post-Processing",
    description:
      "Custom Unity URP render features, shaders, post-processing stack rewrite & visual experiments.",
    image: "/images/urp43.png",
    href: "/projects/urp",
  },
  {
    title: "Candy Dandy",
    description:
      "Casual mobile game. Gameplay programming, tech art integration & client-based development.",
    image: "/images/candy43.png",
    href: "/projects/candy-dandy",
  },
];
---

<Layout
  title="Portfolio | 10KJVN - Jahvairo Monkau"
  description="Personal projects that showcase ideas and other technical achievements."
>
  <Hero />

  <!-- About Me -->
  <SectionSplit title="About Me" image="/images/abtme.jpg">
    <p>
      I'm a technical artist and game developer focusing on rendering, shaders
      and gameplay systems.
    </p>
    <p>
      My work blends low-level graphics exploration with practical game-dev
      problem solving.
    </p>
  </SectionSplit>

  <!-- Features (reverse layout) -->
  <SectionSplit
    title="Gameplay Features"
    image="/images/octo-radialThumb.png"
    reverse={true}
  >
    <p>Contributions made during my time at NeoN Origins!</p>

    <ul class="list-disc pl-6 space-y-2 mt-4 text-white/70">
      <li>Co-developed the first ground-based enemy</li>
      <li>Converted the stamina system to a shader</li>
      <li>Worked on a minimap prototype</li>
    </ul>
  </SectionSplit>

  <!-- Project (text left, media right with hover video) -->
  <SectionSplit title="Tech Art">
    <p>Participated in a Game Jam about Terrain Generation!</p>
    <p>
      Here i learned to work in low-level environments through graphics and
      shader programming in Godot.
    </p>

    <div
      slot="media"
      class="relative group rounded-2xl overflow-hidden shadow-xl"
    >
      <img
        src="/images/DirtJamThumb.png"
        class="w-full h-auto object-cover transition-opacity duration-300 group-hover:opacity-0"
      />

      <video
        src="/videos/Patrolling.mp4"
        autoplay
        muted
        loop
        class="absolute inset-0 w-full h-full object-cover opacity-0 group-hover:opacity-100 transition-opacity duration-300"
      ></video>
    </div>
  </SectionSplit>

  <!-- Highlighted Projects -->
  <section class="py-28 bg-neutral-950 border-t border-white/10">
    <div class="max-w-5xl mx-auto px-6">
      <SectionHeader title="Projects" />

      <div class="grid md:grid-cols-2 gap-8">
        {
          featuredProjects.map((p) => (
            <a
              href={p.href}
              class="group block rounded-xl border border-white/10 p-6 bg-white/2 hover:bg-white/5 transition"
            >
              <h3 class="text-xl font-semibold mb-2">{p.title}</h3>
              <p class="text-white/60">{p.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <ProjectsSection projects={[...featuredProjects, ...otherProjects]} />

  <!-- More Projects -->
  <section class="mt-24">
    <div class="max-w-5xl mx-auto px-6">
      <SectionHeader title="More Projects" />
      <ProjectsGrid projects={otherProjects} />
    </div>
  </section>
</Layout>
