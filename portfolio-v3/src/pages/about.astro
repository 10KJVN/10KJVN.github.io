---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import Timeline from "../components/Timeline.astro";
import Skills from "../components/Skills.astro";
import PhotoTrio from "../components/PhotoTrio.astro";
import { skills } from "../data/skills";

/*
 * The three images beside the intro. They are independent of the timeline: photos of me, work imagery,
 * or a mix. Order matters: [tall, wide, small].
 * Until a slot has a `src` it shows an "Image placeholder" frame. To fill one: put the file in
 * public/images/about/, add  src: "/images/about/<file>.jpg"  and write a real `alt`.
 * A `position` such as "center 20%" sets the focal point of the crop.
 */
const aboutImages: [
    { src?: string; alt: string; caption?: string; position?: string },
    { src?: string; alt: string; caption?: string; position?: string },
    { src?: string; alt: string; caption?: string; position?: string },
] = [
    { alt: "Portrait of me" }, // tall
    { alt: "Me working on a project" }, // wide
    { alt: "Work or project imagery" }, // small
];

const timeline = [
    {
        year: "2026",
        entries: [
            {
                title: "Propaedeutic diploma",
                description:
                    "I've obtained my Propadeutic diploma by completing all my required ECS for the first year at my CMGT studies!",
            },
        ],
    },
    {
        year: "2025",
        entries: [
            {
                title: "HKU",
                description:
                    "Applied last-minute after realizing I was dealing with serious imposter syndrome and didn't feel ready to job-hunt yet. Decided to start over with more passion and motivation, and shape my path on my own terms this time.",
            },
            {
                title: "First Game Jam — The Dirt Jam",
                description:
                    "After receiving feedback that my portfolio didn't show enough solo work to properly assess my individual capabilities, I took it as a personal challenge. I entered Acerola's Dirt Jam during the summer break, using the opportunity to explore terrain generation and graphics programming independently.",
                link: { label: "Way2Terrain", url: "/projects/dirt-jam" },
            },
            {
                title: "MBO Diploma",
                description:
                    "Passed after a resit — the first round of user testing didn't meet the exam criteria, so I ran more sessions and got proper footage. Somewhere in my 3rd year I'd started \"vibe coding,\" believing it would speed up production and teach me more. It did neither — I could put games together, but without real meaning, passion, or design intent behind them.",
            },
            {
                title: "MBO Exams",
                description:
                    "Three companies pitched real assignments — Linx Interactive, Azerion, and the Dutch Navy. Got my preferred client.",
                link: { label: "Candy Dandy", url: "/projects/candy-dandy" },
            },
        ],
    },
    {
        year: "2024",
        entries: [
            {
                title: "Veldboom Studios Internship",
                description:
                    "Focused on Game Mechanics and Architectural Visualization. Introduced SCRUM alongside a colleague at the same studio. Learned 3D scanning, Photoshop texturing, and did UI programming for a Shopify feature inside Unreal Engine.",
            },
            {
                title: "Aspekt Internship — Loznica, Serbia",
                description:
                    "My first internship abroad, working with Media Designers on an iteration of the Bee Project — a game raising awareness of bees' role in the ecosystem. Also freelancing and job-hunting on the side, while building cultural and social self-sufficiency.",
            },
        ],
    },
    {
        year: "2023",
        entries: [
            {
                title: "Freelance Work — The Ensemble",
                description:
                    "Referred by a friend, starting with a website, then game mechanics, and eventually a real client project called The Ensemble — worked on and off for about 2 years.",
                link: { label: "LinkedIn post", url: "https://lnkd.in/p/gtaNGvJG" },
            },
            {
                title: "NeoN Origins",
                description:
                    "A hybrid learning environment where I truly honed my game development skills over the course of a year.",
                link: { label: "NeoN Origins", url: "https://www.neonorigins.com/" },
            },
        ],
    },
    {
        year: "2022",
        entries: [
            {
                title: "First Unity Game",
                description:
                    "First cross-discipline collaboration, working with Game Artists on an 8-week space-themed game for an exposition. The damage system wasn't finished in time, so I faked it live by manually pressing a button.",
            },
        ],
    },
    {
        year: "2021",
        entries: [
            {
                title: "Media College Amsterdam",
                description:
                    "Started as a Software Development course covering Python and basic web development. From the 2nd semester, students could specialize into Game Development or Fullstack Development.",
            },
            {
                title: "First Game — Pac-Man Clone",
                description:
                    "Built a barely-functional Pac-Man clone on Scratch in a day — no wall collision, but you could actually win or lose. Used it to enroll at Media College Amsterdam.",
            },
        ],
    },
];
---

<Layout
        title="About | Jahva's Portfolio"
        description="Who I am and how I got here."
        width="wide"
>
    <!-- A dedicated page, not an article: it uses the wide canvas (like the project pages) with its own gutters.
         Three parts: who I am, how I got here, what I work with. -->
    <div class="mx-auto max-w-[1400px] px-6 py-14 md:px-10 md:py-20 lg:px-16">

        <section class="grid items-center gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-16">
            <div>
                <SectionHeader as="h1" title="About Me" />
                <div class="max-w-xl space-y-4 text-lg leading-relaxed text-text/70 xl:text-xl xl:leading-relaxed">
                    <p>
                        I'm a 21-year-old game developer from Amsterdam, The Netherlands.
                    </p>
                    <p>
                        At the core, I'm a generalist Game Developer with expertise in gameplay and UI programming — games are meant to be played first, which is why gameplay comes before graphics for me.
                        That said, I'm working toward a specialization somewhere between Technical Artist and Graphics Programmer, drawn in by shaders and the visual side of rendering.
                    </p>
                </div>
            </div>

            <PhotoTrio images={aboutImages} />
        </section>

        <section class="mt-24 border-t border-border-strong pt-12 md:mt-28">
            <SectionHeader title="My Story" class="!mb-10" />
            <Timeline groups={timeline} />
        </section>

        <section class="mt-16 border-t border-border-strong pt-12 md:mt-20">
            <SectionHeader title="Skills" subtitle="What I work with, and for how long." />
            <Skills skills={skills} />
        </section>

    </div>
</Layout>