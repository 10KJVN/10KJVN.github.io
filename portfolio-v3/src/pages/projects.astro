---
import Layout from "../layouts/Layout.astro";
import SectionHeader from "../components/SectionHeader.astro";
import FilterBar from "../components/FilterBar.astro";
import ProjectsGrid from "../components/ProjectsGrid.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");

const sorted = [...allProjects].sort(
    (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity)
);

const projects = sorted.map((entry) => ({
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.thumbnail,
    href: `/projects/${entry.id}`,
    tags: entry.data.tags,
    highlight: entry.data.highlight,
}));

const allTags = Array.from(new Set(projects.flatMap((p) => p.tags))).sort();
---

<Layout
        title="Projects | Jahva's Portfolio"
        description="All personal and professional projects."
>
    <section class="py-24">
        <div class="max-w-5xl mx-auto px-6">
            <SectionHeader title="Projects" />

            <FilterBar tags={allTags} />

            <ProjectsGrid projects={projects} />
        </div>
    </section>
</Layout>

